# ==============================================================
# QuickBite Food Delivery - Environment Configuration Template
# ==============================================================
# Copy this file to .env before starting services locally:
# cp .env.example .env

# Global Environment
NODE_ENV=development

# Restaurant Service (Port 5001)
RESTAURANT_SERVICE_PORT=5001

# Order Service (Port 5002)
ORDER_SERVICE_PORT=5002
ORDER_DATABASE_URL="file:./dev.db"
RESTAURANT_SERVICE_URL="http://localhost:5001"
DELIVERY_SERVICE_URL="http://localhost:5003"

# Delivery Service (Port 5003)
DELIVERY_SERVICE_PORT=5003
DELIVERY_DATABASE_URL="file:./delivery.db"

# Customer Frontend (Vite Port 5173 / Production Port 3000)
VITE_RESTAURANT_API_URL="http://localhost:5001"
VITE_ORDER_API_URL="http://localhost:5002"
VITE_DELIVERY_API_URL="http://localhost:5003"
